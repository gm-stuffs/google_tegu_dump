#
# Tegu sensor device configuration registry script for all stages.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-zuma-pro
#

?+0xB0000:0xFFFF0000

#
# Buses
#

# I2C
+/dev/i2c/0
  bus_name=i2c0
  bus_index=0

# I3C
+/dev/i3c/1
  bus_name=i3c1
  bus_index=1

# SPI
+/dev/spi/2
  bus_name=spi2
  bus_index=2

#
# Sensors
#

# IMU (LSM6DSV)
+/dev/lsm6dsv/0
  bus_name=i3c1
  bus_freq_hz=400000
  i3c_freq_hz=1230000
  bus_addr=0x6a
  i3c_addr=0xa
  intr_id=43
  trigger_type=2
  fifo_enabled=1
  md_threshold_m_per_s_sq=1.2264
  md_window_ms=20
  sd_window_ms=5000
  fifo_max_odr=4000
  fifo_max_wm=245
  fifo_min_wm=1
  gpio_id=gpio86
+/dev/lsm6dsv/0/accel
  orientation_transform=-1 -2 3
  avg_odr_30=29.79153
  self_cal_gain=2048 2048 2048
  fac_cal_transform=0.99919 0.0017 -0.00205 -0.00123 0.99939 0.00335 0.0075 -0.00231 0.99963 0.02804 -0.11949 -0.00072
  temp=33.90669
  temp_sensitivity=-0.0010 0.00068 0.00035
+/dev/lsm6dsv/0/gyro
  orientation_transform=-1 -2 3
  avg_odr_30=29.75056
  self_cal_gain=2048 2048 2048
  fac_cal_transform=1.00241 -0.00296 -0.00105 0.00366 0.99956 0.00251 0.00002 -0.00314 1.00036 0.00772 -0.00219 0.00124
  temp=33.90669
  temp_sensitivity=-0.00003 0.00004 -0.00006
+/dev/lsm6dsv/0/temp
+/dev/lsm6dsv/0/motion_detect
+/dev/lsm6dsv/0/stationary_detect
+/dev/lsm6dsv/0/free_fall_detect
  name=LSM6DSV FreeFall Detect

# MAG 1 (MMC5616WA)
+/dev/mmc5616/0
  bus_name=i3c1
  bus_freq_hz=400000
  i3c_freq_hz=6250000
  bus_addr=0x30
  i3c_addr=0x14
  priority=0
+/dev/mmc5616/0/mag
  orientation_transform=1 2 3

# BARO (SPL07003)
+/dev/spl07003/0
  bus_name=i2c0
  bus_freq_hz=400000
  bus_addr=0x77
  intr_id=47
  coeff_a=0.0
  coeff_b=-0.037239
+/dev/spl07003/0/baro
  fac_cal_transform=1.0 -0.23853
  temp=30.83079
  temp_sensitivity=0.00138
+/dev/spl07003/0/temp

# ALSP (TMD3733)
+/dev/tmd3733/0
  bus_name=i2c0
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=45
  anti_aliasing=1
  use_c_histogram=1

+/dev/tmd3733/0/als
  # Number of EM cycles in a 60Hz frame.
  EM_cycle_count_60Hz=4

  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Maximum lux value to report when hitting saturation at minimum gains.
  max_lux=200000
  # OSC TUNE golden cal value.
  osc_tune=-1
  # Display leakage golden cal value.
  leakage_at_dbv=19.584 3427.0 0.108 575.0

+/dev/tmd3733/0/prox
  # Auto-baseline control:
  # 0: Special factory mode that determines one baseline using special settings.
  # 1: Manual baseline calculation using Prox samples from the chip.
  # 2: On-chip baseline calculation ("AXTALK").
  #
  # In the cases 1 and 2 the baseline is regularly recalibrated triggered by a
  # timer.
  #
  # Remove this property to completely disable any kind of baseline calibration.
  auto_baseline=2
  # \todo TODO(b/365883198): Remove below parameters after marking them
  # non-mandatory when parsing the registry in driver.
  # Default panel-agnostic PDATA scale.
  pdata_scale=3.18524
  # Default panel-agnostic pulse length.
  pulse_len_us=64

+/dev/tmd3733/0/panel-a/prox
  # BXTALK golden cal value.
  bxtalk=117
  # PDATA scale golden value.
  pdata_scale=3.18524
  # Temperature coefficient golden cal value.
  temp_coeff=5
  pulse_len_us=64
  # Correction factor for fac-calibrated bxtalk and pdata scale.
  bxtalk_pdscale_fac_cal_correction_factor=2

+/dev/tmd3733/0/panel-b/als
  # OSC TUNE golden cal value.
  osc_tune=-1
  # Display leakage golden cal value.
  leakage_per_device_cal_enable=1
  leakage_at_dbv=49.328 3628 8.278 637.0

+/dev/tmd3733/0/panel-b/prox
  # BXTALK golden cal value.
  bxtalk=311
  # PDATA scale golden value.
  pdata_scale=1.40685
  # Temperature coefficient golden cal value.
  temp_coeff=5
  pulse_len_us=128

# Display Info
+/dev/display_info/0
  # Link to ALS attached to this display.
  attached_alsp=/dev/tmd3733/0

# Camera VSYNC
+/dev/camera_vsync/0 # rear
  intr_id=57
  intr_trigger_type=2
+/dev/camera_vsync/1 # front
  intr_id=58
  intr_trigger_type=2
+/dev/camera_vsync/2 # rear ultra-wide-angle
  intr_id=59
  intr_trigger_type=2

# S3908
+/dev/s3908/0
  bus_name=spi2
  bus_freq_hz=10000000
  spi_mode=0
  spi_word_size=8
  cs_gpio=67
  cs_clock_delay_us=1
  gesture_type=3
  intr_id=14
  intr_type=1
  panel_height_pixel=2424
  panel_height_mm=146
  single_tap_min_x=91
  single_tap_max_x=989
  single_tap_min_y=179
  single_tap_max_y=2245
  single_tap_min_frame_count=3
  single_tap_max_frame_count=31
  single_press_motion_tolerance=255
  single_press_max_touch_size=40
  long_press_min_x=440
  long_press_max_x=640
  long_press_min_y=1655
  long_press_max_y=1855
  long_press_min_frame_count=1
  long_press_motion_tolerance_inner=255
  long_press_max_touch_size=40
  long_press_marginal_min_x=440
  long_press_marginal_max_x=640
  long_press_marginal_min_y=1655
  long_press_marginal_max_y=1855
  long_press_monitor_channel_min_tx=6
  long_press_monitor_channel_max_tx=9
  long_press_monitor_channel_min_rx=24
  long_press_monitor_channel_max_rx=27
  long_press_min_node_count=8
  long_press_motion_tolerance_outer=528
  super_resolution_auto_scale=1

# TBN
+/tbn
  tbn_mode=2

# VSC.
+/vsc
  quick_pick_up_enable=1
  single_tap_enable=1
  long_press_enable=1

+/vsc/auto_brightness
  # float[3]={LuxToEnter, LuxToExit, RemappedLux}
  lux_remap=-1.0 -1.0 -1.0
  # float[3]={MinDelta, MaxDelta, LuxRatio}
  lux_debounce_up=1 5000 0.15
  lux_debounce_down=0.1 5000 0.1
  # ALS[2], RLS[2], Fusion[2], each containing <maxSampleAgeMsec> and <maxNumOfSamples>
  filter_configs=500 60 500 30 500 90

+/vsc/fusion_prox_voice_call
  # 0: Normal (fusion of Optical Prox with other sensors)
  # 1: Optical Prox Passthrough (skips all other fusion logic)
  # 2: Optical Prox Overwrite (runs fusion logic but outputs Optical Prox state)
  mode=0

  # Timeout when in Interactive and FalseFar state before switching to Near.
  # Default: 1000ms
  interactive_false_far_timeout_ms=1000

  # Horizontal angle between device and earth to enter and exit Interactive
  # state. Angles need to be less than 90 degrees, and exit >= enter.
  # Defaults: 45 (enter) and 50 (exit)
  interactive_thresh_angles=45 50

  # Minimum horizontal angle between device and earth to qualify a valid
  # To-Ear gesture. Should be larger than the interactive exit angle.
  # Default: 60
  to_ear_thresh_angle=60

  # Change in horizontal angle between device and earth to trigger a From-Ear
  # event. The initial angle to compare against is taken on a To-Ear event.
  # Default: 30
  from_ear_delta_thresh_angle=30
